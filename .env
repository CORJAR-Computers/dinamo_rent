# Motor: "mysql" o "sqlite"
DINAMO_DB_ENGINE=mysql

# Configuración MySQL (solo si usas MySQL)
DINAMO_DB_HOST=localhost
DINAMO_DB_PORT=3306
DINAMO_DB_USER=root
DINAMO_DB_PASSWORD=
DINAMO_DB_NAME=dinamo_rent

# Opcional: puedes cambiar los valores por defecto de otros parámetros si lo deseas
# DINAMO_BACKUP_HOURS=09:00,13:00,19:00,23:00
# DINAMO_SESSION_TIMEOUT=3600