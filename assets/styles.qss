/* ============================================================================
   styles.qss - Hoja de Estilos Global para Dinamo Rent ERP
   ============================================================================ */

/* --- CONFIGURACIÓN GENERAL --- */
QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #333333;
}

QMainWindow, QStackedWidget {
    background-color: #f0f2f5; /* Fondo general de la app */
}

QDialog {
    background-color: #ffffff;
}

/* --- ETIQUETAS (LABELS) --- */
QLabel {
    color: #424242;
    font-weight: 500;
}

/* --- CAMPOS DE TEXTO Y CONTROLES --- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QTextEdit {
    background-color: #fafafa;
    border: 1px solid #cfd8dc;
    border-radius: 6px;
    padding: 8px;
    color: #212121;
    min-height: 20px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus, QTextEdit:focus {
    border: 2px solid #004aad; /* Azul Dinamo al hacer clic */
    background-color: #ffffff;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background-color: #eeeeee;
    color: #9e9e9e;
}

/* Ocultar flechitas feas de los combos y poner una moderna */
QComboBox::drop-down {
    border: none;
    width: 30px;
}

/* --- BOTONES GLOBALES --- */
QPushButton {
    background-color: #e0e0e0;
    color: #424242;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #bdbdbd;
}

QPushButton:pressed {
    background-color: #9e9e9e;
}

/* --- BOTONES CON CLASES (SIMULANDO CSS HTML) --- */
/* Botón Principal (Azul Dinamo) */
QPushButton[cssClass="primary"] {
    background-color: #004aad;
    color: white;
    border: none;
}
QPushButton[cssClass="primary"]:hover {
    background-color: #003380;
}

/* Botón Éxito (Verde Guardar) */
QPushButton[cssClass="success"] {
    background-color: #2e7d32;
    color: white;
    border: none;
}
QPushButton[cssClass="success"]:hover {
    background-color: #1b5e20;
}

/* Botón Peligro (Rojo Eliminar/Cancelar) */
QPushButton[cssClass="danger"] {
    background-color: #c62828;
    color: white;
    border: none;
}
QPushButton[cssClass="danger"]:hover {
    background-color: #b71c1c;
}

/* Botón Alerta (Naranja) */
QPushButton[cssClass="warning"] {
    background-color: #ef6c00;
    color: white;
    border: none;
}
QPushButton[cssClass="warning"]:hover {
    background-color: #e65100;
}

/* --- TABLAS (DATAGRID) --- */
QTableWidget, QTableView {
    background-color: #ffffff;
    alternate-background-color: #f9f9f9;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    gridline-color: #eeeeee;
    selection-background-color: #e3f2fd; /* Azul clarito al seleccionar */
    selection-color: #004aad;
}

QHeaderView::section {
    background-color: #004aad; /* Cabecera Azul Dinamo */
    color: white;
    font-weight: bold;
    padding: 8px;
    border: none;
    border-right: 1px solid #003380;
}

/* --- GROUP BOXES (CONTENEDORES) --- */
QGroupBox {
    font-weight: bold;
    border: 1px solid #cfd8dc;
    border-radius: 8px;
    margin-top: 15px;
    padding-top: 15px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 15px;
    top: -8px;
    color: #004aad;
    background-color: transparent;
}

/* --- SCROLLBARS MODERNAS --- */
QScrollBar:vertical {
    border: none;
    background: #f0f0f0;
    width: 10px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #c0c0c0;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #a0a0a0;
}