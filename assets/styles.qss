/* ============================================================
   Dinamo Rent ERP — Hoja de Estilos Global (Tema: Dinamo Pro)
   ============================================================ */

/* ── Base ─────────────────────────────────────────────────── */
QMainWindow {
    background-color: #f8fafc; /* slate-50 */
}
QWidget {
    font-family: "Segoe UI", "Segoe UI Emoji", sans-serif;
    font-size: 11pt;
    color: #0f172a; /* slate-900 */
}

/* ── QLineEdit ────────────────────────────────────────────── */
QLineEdit {
    padding: 8px 12px;
    border: 1px solid #e2e8f0; /* slate-200 */
    border-radius: 8px;
    background-color: #ffffff;
    color: #0f172a; /* slate-900 */
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    font-size: 11pt;
}
QLineEdit:hover {
    border-color: #cbd5e1; /* slate-300 */
}
QLineEdit:focus {
    border-color: #2563eb; /* blue-600 */
    background-color: #ffffff;
}
QLineEdit:read-only {
    background-color: #f1f5f9; /* slate-100 */
    color: #64748b; /* slate-500 */
    border-color: #e2e8f0; /* slate-200 */
}

/* ── QTableWidget ─────────────────────────────────────────── */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc; /* slate-50 */
    gridline-color: #f1f5f9; /* slate-100 */
    border: 1px solid #e2e8f0; /* slate-200 */
    border-radius: 12px;
    selection-background-color: #dbeafe; /* blue-100 */
    selection-color: #0f172a;
}
QTableWidget::item {
    padding: 12px 10px;
    border-bottom: 1px solid #f1f5f9; /* slate-100 */
}
QTableWidget::item:selected {
    background-color: #bfdbfe; /* blue-200 */
}
QTableWidget::item:hover {
    background-color: #f8fafc; /* slate-50 */
}

QHeaderView::section {
    background-color: #f8fafc; /* slate-50 */
    color: #475569; /* slate-600 */
    font-weight: 600;
    font-size: 10pt;
    padding: 12px 10px;
    border: none;
    border-bottom: 1px solid #e2e8f0; /* slate-200 */
}

/* ── QGroupBox ────────────────────────────────────────────── */
QGroupBox {
    font-weight: 600;
    font-size: 13pt;
    color: #0f172a;
    border: 1px solid #e2e8f0; /* slate-200 */
    border-radius: 12px;
    margin-top: 14px;
    padding: 24px 18px 18px 18px;
    background-color: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 10px;
    margin-left: 10px;
    background-color: #ffffff;
}

/* ── QTabWidget ───────────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    background-color: transparent;
    padding: 10px 0px;
}
QTabBar::tab {
    background-color: transparent;
    color: #64748b; /* slate-500 */
    padding: 12px 20px;
    border-bottom: 2px solid transparent;
    margin-right: 8px;
    font-weight: 600;
    font-size: 11pt;
}
QTabBar::tab:selected {
    color: #2563eb;
    border-bottom: 2px solid #2563eb;
}
QTabBar::tab:hover {
    color: #0f172a;
    background-color: #f1f5f9;
}

/* ── QComboBox ────────────────────────────────────────────── */
QComboBox {
    padding: 8px 12px;
    border: 1px solid #e2e8f0; /* slate-200 */
    border-radius: 8px;
    background-color: #ffffff;
    color: #0f172a;
    font-size: 11pt;
}
QComboBox:hover {
    border-color: #cbd5e1; /* slate-300 */
}
QComboBox:focus {
    border-color: #2563eb;
}
QComboBox::drop-down {
    border: none;
    width: 30px;
}
QComboBox QAbstractItemView {
    border: 1px solid #e2e8f0; /* slate-200 */
    background-color: #ffffff;
    selection-background-color: #dbeafe; /* blue-100 */
    selection-color: #0f172a;
    padding: 6px;
    border-radius: 8px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #eff6ff; /* blue-50 */
}

/* ── QDateEdit / QSpinBox / QDoubleSpinBox ────────────────── */
QDateEdit, QSpinBox, QDoubleSpinBox {
    padding: 8px 12px;
    border: 1px solid #e2e8f0; /* slate-200 */
    border-radius: 8px;
    background-color: #ffffff;
    color: #0f172a;
    font-size: 11pt;
}
QDateEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #cbd5e1; /* slate-300 */
}
QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2563eb;
}

/* ── QPlainTextEdit / QTextEdit ───────────────────────────── */
QPlainTextEdit, QTextEdit {
    border: 1px solid #e2e8f0; /* slate-200 */
    border-radius: 8px;
    background-color: #ffffff;
    color: #0f172a;
    padding: 10px;
    font-size: 11pt;
}
QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #2563eb;
}

/* ── QDialog ──────────────────────────────────────────────── */
QDialog {
    background-color: #f8fafc; /* slate-50 */
}

/* ── ScrollBars ───────────────────────────────────────────── */
QScrollArea {
    border: none;
    background-color: transparent;
}
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1; /* slate-300 */
    border-radius: 6px;
    min-height: 40px;
}
QScrollBar::handle:vertical:hover {
    background: #94a3b8; /* slate-400 */
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #cbd5e1; /* slate-300 */
    border-radius: 6px;
    min-width: 40px;
}
QScrollBar::handle:horizontal:hover {
    background: #94a3b8; /* slate-400 */
}

/* ── QMessageBox ──────────────────────────────────────────── */
QMessageBox {
    background-color: #ffffff;
}
QMessageBox QLabel {
    font-size: 11pt;
    min-width: 350px;
    color: #334155; /* slate-700 */
}

/* ── Tooltips ─────────────────────────────────────────────── */
QToolTip {
    background-color: #0f172a; /* slate-900 */
    color: #ffffff;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 10pt;
    border: none;
}

/* ── QProgressBar ─────────────────────────────────────────── */
QProgressBar {
    border: none;
    border-radius: 8px;
    background-color: #e2e8f0; /* slate-200 */
    text-align: center;
    height: 16px;
}
QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 8px;
}

/* ── QCalendarWidget ──────────────────────────────────────── */
QCalendarWidget QToolButton {
    background-color: transparent;
    border: none;
    color: #0f172a;
    font-size: 12pt;
    font-weight: 600;
}
QCalendarWidget QToolButton:hover {
    background-color: #f1f5f9;
}
#qt_calendar_navigationbar {
    background-color: #f8fafc;
}
#qt_calendar_prevmonth, #qt_calendar_nextmonth {
    qproperty-iconSize: 0px;
    min-width: 40px;
}

/* ── Labels de texto ──────────────────────────────────────── */
QLabel {
    color: #334155; /* slate-700 */
    background-color: transparent;
}
QLabel[heading="true"] {
    font-size: 20pt;
    font-weight: 700;
    color: #0f172a; /* slate-900 */
}
QLabel[subtitle="true"] {
    font-size: 14pt;
    font-weight: 600;
    color: #2563eb; /* blue-600 */
}
QLabel[muted="true"] {
    color: #64748b; /* slate-500 */
    font-size: 10pt;
}

/* ── Accesibilidad ──────────────────────────────────────── */
QLabel:disabled {
    color: #94a3b8; /* slate-400 */
}