# ── Normalize all text files to LF in the repository ──
* text=auto eol=lf

# ── Source code (always LF) ──
*.py        text eol=lf
*.pyw       text eol=lf
*.pyi       text eol=lf
*.pyx       text eol=lf
*.qss       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.htm       text eol=lf
*.xml       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.ini.example text eol=lf
*.txt       text eol=lf
*.md        text eol=lf
*.sql       text eol=lf
*.jinja     text eol=lf
*.jinja2    text eol=lf
*.mako      text eol=lf
*.spec      text eol=lf

# ── Git / CI files (always LF) ──
.gitignore      text eol=lf
.gitattributes  text eol=lf

# ── Shell scripts (always LF, even on Windows) ──
*.sh        text eol=lf
*.bash      text eol=lf

# ── Batch scripts (CRLF on Windows, LF in repo) ──
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ── Binary files (never modify) ──
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.webp      binary
*.bmp       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.7z        binary
*.rar       binary
*.exe       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.pyd       binary
*.fdb       binary
*.sqlite    binary
*.db        binary
*.icns      binary
