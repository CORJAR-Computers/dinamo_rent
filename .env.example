# =====================================================================
# Dinamo Rent ERP — .env.example
# =====================================================================
# Copiar este archivo a .env y configurar las variables
# NUNCA commitear el archivo .env al repositorio
# =====================================================================

# ── Base de Datos ──────────────────────────────────────────────────
# Motor: mysql o sqlite
DINAMO_DB_ENGINE=mysql

# Configuración MySQL
DINAMO_DB_HOST=localhost
DINAMO_DB_PORT=3306
DINAMO_DB_USER=root
# IMPORTANTE: Cambiar por una contraseña segura
DINAMO_DB_PASSWORD=TuPasswordSeguro123!
DINAMO_DB_NAME=dinamo_rent

# ── Aplicación ─────────────────────────────────────────────────────
# Nombre de la aplicación
DINAMO_APP_NAME=Dinamo Rent ERP

# ── Seguridad ──────────────────────────────────────────────────────
# Tiempo de sesión en segundos (default: 3600 = 1 hora)
DINAMO_SESSION_TIMEOUT=3600

# Intentos máximos antes de bloqueo (default: 5)
DINAMO_MAX_LOGIN_ATTEMPTS=5

# Duración del bloqueo en segundos (default: 1800 = 30 min)
DINAMO_ACCOUNT_LOCKOUT_DURATION=1800

# ── Backups ────────────────────────────────────────────────────────
# Encriptar backups automáticamente (true/false)
DINAMO_BACKUP_ENCRYPTION=true

# Contraseña para encriptar backups (dejar vacío para auto-generar)
DINAMO_BACKUP_ENCRYPTION_PASSWORD=
